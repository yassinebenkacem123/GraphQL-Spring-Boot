type Query{
    books: [Book],
    authors: [Author]
}

type Mutation{
    createAuthor(authorDTO: AuthorDTO): ResponseDTO
}

type Book{
    bookId: ID,
    title: String,
    description: String
    author: Author
}

type Author{
    authorId: ID,
    name: String,
    email: String
    books: [Book]
}

input AuthorDTO{
    name: String
    email: String
}

type ResponseDTO{
    status: String
    message: String
}

